# Turso / libSQL credentials.
# Get them with:  turso db show <name> --url   and   turso db tokens create <name>
# Vercel also accepts the TURSO_DATABASE_URL / TURSO_AUTH_TOKEN names.
DB_URI="libsql://your-database.turso.io"
DB_TOKEN="your-token"

# Optional. Overrides maxUsers in app.config.js for this deployment.
# MAX_USERS=5

# Optional. Comma-separated origins allowed to call the API.
# Needed when the front end is on GitHub Pages and the API is on Vercel.
# Defaults to "*".
# ALLOWED_ORIGINS=https://youruser.github.io,https://your-app.vercel.app
